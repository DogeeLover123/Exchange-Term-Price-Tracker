# Copy to .env and fill in. Never commit .env (it's in .gitignore).
# Load with:  export $(grep -v '^#' .env | xargs)

# Travelpayouts: travelpayouts.com -> Tools -> API -> token
TRAVELPAYOUTS_TOKEN=

# SerpApi (Google Flights verification): serpapi.com -> API key. Several keys comma-separated.
SERPAPI_KEYS=

# Email digest (Gmail: Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
EMAIL_TO=you@gmail.com

# Optional: GitHub Pages URL of the trail board, turns on the "Save" links in the email
# DASHBOARD_URL=https://<you>.github.io/<repo>
